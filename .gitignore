node_modules
.next
out
*.tsbuildinfo
next-env.d.ts

# Arbeitsdateien, die nicht ins Repository gehören
.vorschau-tmp
abzug
assets-quelle/*-motion-roh.mp4

# Die Vorschau ist eine erzeugte Datei (npm run vorschau)
vorschau
modelle/

# Quellstandbilder von Band 1 liegen nicht im Repository: Die Bewegtfassungen
# wurden aus den bereits versionierten Ableitungen unter public/assets erzeugt,
# ein zweites Mal dieselben Bilder als JPEG wären 17 MB ohne Nutzen.
/assets-quelle/*.jpg
/assets-quelle/*-motion-roh.mp4
assets-quelle/**/*-motion-roh.mp4

# Zugangsschluessel — niemals ins Repository
.env
.env.local
.env*.local
!.env.example

# Arbeitsprotokolle lokaler Laeufe
build.log
typecheck.log
npm-install.log
st.txt
journal-nachricht.txt
journal-commit.cmd
journal-push.cmd

# Der Schluessel des Google-Dienstkontos gehoert nirgends hierher.
# Er liegt in AUTOPILOT/REGISTRIERUNG/. Diese Zeilen sind das Netz darunter,
# falls die Datei doch einmal im Repository landet.
google-dienstkonto.json
*-dienstkonto.json
*.serviceaccount.json

# „Alles nur Zufall?“ — Rohmaterial bleibt draußen (319 MB).
# Die vierzig Kapitelmotive sind der Satz des Buches, die Bewegtfassungen
# kommen von kie.ai, die Hochformate entstehen dazwischen. Alles davon ist
# jederzeit wiederherzustellen: Motive aus dem Buchordner,
# `node scripts/zufall-hochkant-alle.mjs`, dann `scripts/zufall-motion.mjs`.
# Ins Web geht ohnehin nur, was unter public/assets/zufall/ liegt.
assets-quelle/zufall/kapitel/
assets-quelle/zufall/motion/
assets-quelle/zufall/hochkant/
assets-quelle/zufall/probe/
assets-quelle/zufall/kontaktabzug.jpg
# Die Bühne bleibt drin: `handy-gerade.jpg` ist das entzerrte Foto, und die
# Entzerrung steckt in vier gemessenen Eckpunkten, nicht in einem Skript.
  
# Berichte der Pruefskripte - sie entstehen bei jedem Lauf neu.  
*.log  
